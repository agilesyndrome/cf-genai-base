{
  "name": "@agilesyndrome/cf-genai-base",
  "version": "5.0.4-pre",
  "type": "module",
  "bin": {
    "cf-genai": "bin/cf-genai.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js",
      "default": "./dist/data/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    },
    "./event-hub": {
      "types": "./dist/core/events/hub.d.ts",
      "import": "./dist/core/events/hub.js",
      "default": "./dist/core/events/hub.js"
    },
    "./repository": {
      "types": "./dist/repository.d.ts",
      "import": "./dist/repository.js",
      "default": "./dist/repository.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.js",
      "default": "./dist/domain/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./core/circuits": {
      "types": "./dist/core/circuits/index.d.ts",
      "import": "./dist/core/circuits/index.js",
      "default": "./dist/core/circuits/index.js"
    },
    "./core/database": {
      "types": "./dist/core/database/index.d.ts",
      "import": "./dist/core/database/index.js",
      "default": "./dist/core/database/index.js"
    },
    "./core/events": {
      "types": "./dist/core/events/index.d.ts",
      "import": "./dist/core/events/index.js",
      "default": "./dist/core/events/index.js"
    },
    "./core/healthchecks": {
      "types": "./dist/core/healthchecks/index.d.ts",
      "import": "./dist/core/healthchecks/index.js",
      "default": "./dist/core/healthchecks/index.js"
    },
    "./core/jobs": {
      "types": "./dist/core/jobs/index.d.ts",
      "import": "./dist/core/jobs/index.js",
      "default": "./dist/core/jobs/index.js"
    },
    "./core/security": {
      "types": "./dist/core/security/index.d.ts",
      "import": "./dist/core/security/index.js",
      "default": "./dist/core/security/index.js"
    },
    "./auth/identity": {
      "types": "./dist/auth/identity/index.d.ts",
      "import": "./dist/auth/identity/index.js",
      "default": "./dist/auth/identity/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./ui/ssr": {
      "types": "./dist/ui/ssr.d.ts",
      "import": "./dist/ui/ssr.js",
      "default": "./dist/ui/ssr.js"
    },
    "./ui/react": {
      "types": "./dist/ui/react/index.d.ts",
