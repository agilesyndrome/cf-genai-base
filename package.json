{
  "name": "@agilesyndrome/cf-genai-base",
  "version": "1.0.3",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./authorization": "./src/authorization.js",
    "./core": "./src/core.js",
    "./ui": "./src/ui/index.js",
    "./ui/styles.css": "./src/ui/styles.css"
  },
  "description": "Lean Worker lifecycle and security helpers for Cloudflare sites.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "src",
    "migrations",
    "README.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agilesyndrome/cf-genai-base.git"
  },
  "homepage": "https://github.com/agilesyndrome/cf-genai-base#readme",
  "scripts": {
    "check": "node --check src/index.js && node --check src/core.js && node --check src/authorization.js",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run check && npm test && npm pack --dry-run"
  }
}
