      "default": "./dist/ui/react/index.js"
    },
    "./ui/styles.css": "./dist/ui/styles.css",
    "./features": {
      "types": "./dist/features/index.d.ts",
      "import": "./dist/features/index.js",
      "default": "./dist/features/index.js"
    },
    "./features/llm": {
      "types": "./dist/features/llm/index.d.ts",
      "import": "./dist/features/llm/index.js",
      "default": "./dist/features/llm/index.js"
    },
    "./features/messaging": {
      "types": "./dist/features/messaging/index.d.ts",
      "import": "./dist/features/messaging/index.js",
      "default": "./dist/features/messaging/index.js"
    },
    "./cli": {
      "types": "./dist/cli/cli.d.ts",
      "import": "./dist/cli/cli.js",
      "default": "./dist/cli/cli.js"
    },
    "./cli/*": {
      "types": "./dist/cli/*.d.ts",
      "import": "./dist/cli/*.js",
      "default": "./dist/cli/*.js"
