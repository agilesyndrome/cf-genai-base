  "description": "Cloudflare Worker lifecycle, security, administration, and operational CLI helpers.",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "bin",
    "dist",
    "migrations",
    "README.md",
    "CLI.md",
    "CHANGELOG.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agilesyndrome/cf-genai-base.git"
  },
  "homepage": "https://github.com/agilesyndrome/cf-genai-base#readme",
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck",
    "compile": "tsc -p tsconfig.build.json",
    "assets": "node scripts/copy-build-assets.mjs",
    "prepack": "npm run clean && npm run compile && npm run assets",
    "verify:build": "node scripts/verify-build.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:integration": "node --import tsx --test examples/todo-list/test/integration.test.mjs",
    "build": "npm run check && npm run prepack && npm test && npm run verify:build && npm pack --dry-run --ignore-scripts --loglevel=error"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "hono": "^4.13.8"
  }
}
